# ============================================
# 로컬 개발 환경 설정 템플릿
# 이 파일을 복사하여 application-local.properties를 생성하고 값을 채워넣으세요
# ============================================

# JWT 키 (민감 정보)
spring.jwt.key=YOUR_JWT_KEY_HERE

# EndPoint (민감 정보)
Security.backEndPoint=YOUR_ENDPOINT_KEY_HERE

# 데이터베이스 설정 (민감 정보)
spring.datasource.url=jdbc:mariadb://localhost:3306/AI_Watermark?serverTimezone=UTC&characterEncoding=UTF-8
spring.datasource.driverClassName=org.mariadb.jdbc.Driver
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD

# 메일 설정 (민감 정보)
spring.mail.host=smtp.naver.com
spring.mail.port=465
spring.mail.username=YOUR_MAIL_USERNAME
spring.mail.password=YOUR_MAIL_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.ssl.trust=smtp.naver.com
spring.mail.properties.mail.smtp.ssl.enable=true
spring.mail.default-encoding=UTF-8
spring.mail.from=YOUR_MAIL_FROM
spring.mail.properties.mail.debug=true

# Redis 설정 (민감 정보)
spring.redis.host=localhost
spring.redis.port=6379
spring.redis.password=YOUR_REDIS_PASSWORD

