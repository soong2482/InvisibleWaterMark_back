# ============================================
# 운영 환경 설정 템플릿
# 이 파일을 복사하여 application-prod.properties를 생성하고 값을 채워넣으세요
# ============================================

# JWT 키 (민감 정보)
spring.jwt.key=YOUR_PROD_JWT_KEY_HERE

# EndPoint (민감 정보)
Security.backEndPoint=YOUR_PROD_ENDPOINT_KEY_HERE

# 데이터베이스 설정 (민감 정보)
spring.datasource.url=jdbc:mariadb://YOUR_PROD_DB_HOST:3306/AI_Watermark?serverTimezone=UTC&characterEncoding=UTF-8
spring.datasource.driverClassName=org.mariadb.jdbc.Driver
spring.datasource.username=YOUR_PROD_DB_USERNAME
spring.datasource.password=YOUR_PROD_DB_PASSWORD

# 메일 설정 (민감 정보)
spring.mail.host=smtp.naver.com
spring.mail.port=465
spring.mail.username=YOUR_PROD_MAIL_USERNAME
spring.mail.password=YOUR_PROD_MAIL_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.ssl.trust=smtp.naver.com
spring.mail.properties.mail.smtp.ssl.enable=true
spring.mail.default-encoding=UTF-8
spring.mail.from=YOUR_PROD_MAIL_FROM
spring.mail.properties.mail.debug=false

# Redis 설정 (민감 정보)
spring.redis.host=YOUR_PROD_REDIS_HOST
spring.redis.port=6379
spring.redis.password=YOUR_PROD_REDIS_PASSWORD

